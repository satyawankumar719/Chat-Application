{
  "name": "chat-application-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit:client": "npm run lint --prefix client && npm run build --prefix client",
    "precommit:server": "npm run build --prefix server"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3"
  }
}
